# 줄바꿈: 저장소는 LF. Unity가 YAML 에셋을 LF로 다시 써도 변경으로 잡히지 않도록 Unity 텍스트 에셋은 작업 폴더도 LF로 고정한다 (1-6).
* text=auto

# Unity YAML · 텍스트 에셋
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.overrideController text eol=lf
*.physicMaterial text eol=lf
*.physicsMaterial2D text eol=lf
*.playable text eol=lf
*.mask text eol=lf
*.brush text eol=lf
*.flare text eol=lf
*.fontsettings text eol=lf
*.guiskin text eol=lf
*.giparams text eol=lf
*.renderTexture text eol=lf
*.spriteatlas text eol=lf
*.spriteatlasv2 text eol=lf
*.terrainlayer text eol=lf
*.lighting text eol=lf
*.shadergraph text eol=lf
*.shadersubgraph text eol=lf
*.inputactions text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf
*.json text eol=lf
*.txt text
*.md text
*.cs text diff=csharp
*.shader text
*.hlsl text
*.cginc text
*.uss text
*.uxml text

